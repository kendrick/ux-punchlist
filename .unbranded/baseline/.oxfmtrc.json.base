{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"endOfLine": "lf",
	"ignorePatterns": [
		".unbranded/**",
		"node_modules/**",
		"dist/**",
		"build/**",
		"out/**",
		".next/**",
		"coverage/**",
		"pnpm-lock.yaml",
		"package-lock.json",
		"package.json",
		"**/*.md"
	]
}
