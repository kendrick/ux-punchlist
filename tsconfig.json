{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		"fixtures/**/*.ts",
		"*.config.ts",
		"*.config.mjs"
	],
	"exclude": ["node_modules", "dist", "build", ".next", "out"]
}
